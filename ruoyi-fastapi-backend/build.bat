@echo off
chcp 65001 >nul
setlocal EnableDelayedExpansion
cd /d "%~dp0"

if /i "%~1"=="--nested" (set "NESTED=1") else (set "NESTED=")

set "PY=%~dp0venv\Scripts\python.exe"
if not exist "%PY%" (
    echo ERROR: Cannot find "%PY%", please create venv in ruoyi-fastapi-backend first
    if not defined NESTED pause
    exit /b 1
)

"%PY%" -c "import build" >nul 2>&1
if errorlevel 1 (
    echo build module not installed, installing to venv...
    "%PY%" -m pip install build
    if errorlevel 1 (
        echo ERROR: pip install build failed
        if not defined NESTED pause
        exit /b 1
    )
)

set "BE=%~dp0"
if "%BE:~-1%"=="\" set "BE=%BE:~0,-1%"
for %%I in ("%BE%\..") do set "OUT=%%~fI\dist"

if not exist "%BE%\version.py" (
    echo ERROR: Cannot find version.py
    if not defined NESTED pause
    exit /b 1
)

for /f "tokens=2 delims='" %%A in ('findstr /c:"appVersion" "%BE%\version.py"') do set "BE_VERSION=%%A"
if not defined BE_VERSION (
    echo ERROR: Failed to read appVersion from version.py
    if not defined NESTED pause
    exit /b 1
)

echo [Backend] Version %BE_VERSION%
if not exist "%OUT%" mkdir "%OUT%"
call :clean_backend_build

echo [Backend] Copying config to config package (for wheel)
copy /Y "%BE%\.env.*" "%BE%\config\" >nul
if exist "%BE%\alembic.ini" (
    copy /Y "%BE%\alembic.ini" "%BE%\config\alembic.ini" >nul
    "%PY%" -c "from pathlib import Path; p=Path(r'%BE%\config\alembic.ini'); t=p.read_text(encoding='utf-8'); p.write_text(t.replace('%%(here)s/alembic','%%(here)s/../alembic'), encoding='utf-8')"
)

echo [Backend] python -m build --wheel
"%PY%" -m build --wheel --outdir "%OUT%"
if errorlevel 1 (
    echo ERROR: Backend wheel build failed
    call :clean_backend_build
    if not defined NESTED pause
    exit /b 1
)

if exist "%BE%\whl\*.whl" copy /Y "%BE%\whl\*.whl" "%OUT%\" >nul

call :update_db_sql
if errorlevel 1 (
    call :clean_backend_build
    if not defined NESTED pause
    exit /b 1
)

call :clean_backend_build

echo Backend build completed:
dir /b "%OUT%\*%BE_VERSION%*.whl"
echo.
echo Install: pip install --find-links dist dist\pgt-%BE_VERSION%-py3-none-any.whl
echo Code location: site-packages\pgt\
echo Runtime data: %%LOCALAPPDATA%%\PGT\ (do not write logs into site-packages)
echo To start the application:
echo To start the application:
echo Method 1: ruoyi app run
echo Method 2: python -m pgt.app --env prod
echo For  Dev: python app.py --env=dev
echo.
if not defined NESTED pause
endlocal
exit /b 0

:clean_backend_build
if exist "%BE%\build" rd /s /q "%BE%\build"
if exist "%BE%\.eggs" rd /s /q "%BE%\.eggs"
pushd "%BE%"
for /d %%D in (*.egg-info) do rd /s /q "%%D"
popd
if exist "%BE%\__pycache__" rd /s /q "%BE%\__pycache__"
del /q "%BE%\config\.env.*" >nul 2>nul
if exist "%BE%\config\alembic.ini" del /q "%BE%\config\alembic.ini" >nul 2>nul
exit /b 0

:update_db_sql
rem ==== Database files (MySQL only) ====
rem  - sql\ruoyi-fastapi-my.sql (latest full schema + data, every patch merged) -> dist\db\ and PGT.zip PGT/mysql/sql/
rem  - sql\patches\V<4 digits>__<desc>.sql (source of truth, immutable once released) -> dist\db\patches\
rem  - generates zz_schema_version.sql (sorts after ruoyi-fastapi-my.sql) -> dist\db\ and PGT.zip PGT/mysql/sql/:
rem    creates schema_version and records every patch present now as BASELINE with its SHA-256,
rem    so on a new database db_patches_apply.bat runs only patches added later
rem  - mysql runs PGT/mysql/sql (/docker-entrypoint-initdb.d) only when its data dir is empty (first install)
set "SQL_SRC=%BE%\sql\ruoyi-fastapi-my.sql"
set "PATCH_SRC=%BE%\sql\patches"
set "DB_OUT=%OUT%\db"
set "PGT_ZIP=%OUT%\deploy\PGT.zip"
rem same DDL as service\update\db_patches_apply.bat
set "SV_DDL=create table if not exists schema_version (version varchar(32) not null primary key comment 'patch version from the file name, e.g. 0001', script varchar(255) not null comment 'patch file name', checksum char(64) not null comment 'SHA-256 of the patch file', type varchar(16) not null comment 'BASELINE: merged into the init SQL; SQL: applied by db_patches_apply', success tinyint not null comment '1 applied, 0 failed', installed_on datetime not null default current_timestamp comment 'when recorded') engine=innodb default charset=utf8mb4 comment='applied db patches'"
if not exist "%SQL_SRC%" (echo ERROR: %SQL_SRC% not found & exit /b 1)
if not exist "%PATCH_SRC%\" (echo ERROR: %PATCH_SRC% not found & exit /b 1)
if not exist "%DB_OUT%" mkdir "%DB_OUT%"
echo [Backend] Copying ruoyi-fastapi-my.sql and patches to %DB_OUT%
copy /Y "%SQL_SRC%" "%DB_OUT%\ruoyi-fastapi-my.sql" >nul
if errorlevel 1 (echo ERROR: copy %SQL_SRC% failed & exit /b 1)
robocopy "%PATCH_SRC%" "%DB_OUT%\patches" *.sql /MIR /NJH /NJS /NDL /NFL /NP >nul
if errorlevel 8 (echo ERROR: copy %PATCH_SRC% failed & exit /b 1)
powershell -NoP -C "$ErrorActionPreference='Stop'; $d=$env:DB_OUT; $l=New-Object Collections.Generic.List[string]; $l.Add('-- generated by ruoyi-fastapi-backend\build.bat, do not edit'); $l.Add('-- new database only: patches already merged into ruoyi-fastapi-my.sql are recorded as BASELINE'); $l.Add('set names utf8mb4;'); $l.Add($env:SV_DDL + ';'); $seen=@{}; foreach($f in @(Get-ChildItem -LiteralPath (Join-Path $d 'patches') -Filter '*.sql' | Sort-Object Name)){ if(-not ($f.Name -cmatch '^V(\d{4})__\w+\.sql$')){ throw ('bad patch file name ' + $f.Name + ' (must be V<4 digits>__<desc>.sql)') }; $v=$Matches[1]; if($seen[$v]){ throw ('duplicate patch version ' + $v + ': ' + $seen[$v] + ', ' + $f.Name) }; $seen[$v]=$f.Name; $h=(Get-FileHash -LiteralPath $f.FullName -Algorithm SHA256).Hash.ToLower(); $l.Add(('insert into schema_version(version, script, checksum, type, success) values (''{0}'', ''{1}'', ''{2}'', ''BASELINE'', 1);' -f $v, $f.Name, $h)) }; [IO.File]::WriteAllLines((Join-Path $d 'zz_schema_version.sql'), $l); Write-Output ('[Backend] zz_schema_version.sql: {0} patch(es) recorded as BASELINE' -f $seen.Count)"
if errorlevel 1 (echo ERROR: generating zz_schema_version.sql failed & exit /b 1)
if not exist "%PGT_ZIP%" (echo ERROR: %PGT_ZIP% not found & exit /b 1)
echo [Backend] Checking PGT/mysql/sql in %PGT_ZIP%
rem same content as in PGT.zip: leave PGT.zip untouched (byte-identical between builds); otherwise update a temp copy, entries get the time of sql\ruoyi-fastapi-my.sql, replace PGT.zip only when everything succeeded
powershell -NoP -C "$ErrorActionPreference='Stop'; Add-Type -A System.IO.Compression.FileSystem; $names=@('ruoyi-fastapi-my.sql', 'zz_schema_version.sql'); $sha=[Security.Cryptography.SHA256]::Create(); function Get-Sha256($s){ try { [Convert]::ToBase64String($sha.ComputeHash($s)) } finally { $s.Dispose() } }; $same=$true; $z=[IO.Compression.ZipFile]::OpenRead($env:PGT_ZIP); try { $old=@($z.Entries | Where-Object { $_.FullName -like 'PGT/mysql/sql/*.sql' }); if($old.Count -ne $names.Count){ $same=$false } else { foreach($f in $names){ $e=$z.GetEntry('PGT/mysql/sql/' + $f); if(-not $e -or (Get-Sha256 $e.Open()) -ne (Get-Sha256 ([IO.File]::OpenRead((Join-Path $env:DB_OUT $f))))){ $same=$false; break } } } } finally { $z.Dispose() }; if($same){ Write-Output '[Backend] PGT/mysql/sql unchanged, PGT.zip left as is'; exit 0 }; $ts=[DateTimeOffset](Get-Item -LiteralPath $env:SQL_SRC).LastWriteTime; $t=$env:PGT_ZIP + '.tmp'; Copy-Item -LiteralPath $env:PGT_ZIP $t -Force; $z=[IO.Compression.ZipFile]::Open($t, 'Update'); try { @($z.Entries | Where-Object { $_.FullName -like 'PGT/mysql/sql/*.sql' }) | ForEach-Object { $_.Delete() }; foreach($f in $names){ $e=[IO.Compression.ZipFileExtensions]::CreateEntryFromFile($z, (Join-Path $env:DB_OUT $f), 'PGT/mysql/sql/' + $f); $e.LastWriteTime=$ts } } finally { $z.Dispose() }; Move-Item -LiteralPath $t $env:PGT_ZIP -Force; Write-Output '[Backend] PGT/mysql/sql updated in PGT.zip'"
if errorlevel 1 (echo ERROR: updating PGT/mysql/sql in PGT.zip failed & del /q "%PGT_ZIP%.tmp" >nul 2>nul & exit /b 1)
exit /b 0
