# =============================================================================
# HIL（硬件在环）统一配置 —— hil.env
# =============================================================================
# 位置：与 run_hil.bat、hil/ 同级（包根目录）。
# 加载：hil/config.py 启动时 load_dotenv(本文件, override=False)
#   1) 进程里已有的同名环境变量优先（临时调试：先 set HIL_xxx=... 再 run_hil）
#   2) 否则用本文件的值
#   3) 代码里不再写死 IP / 密码 / COM / vendor 等回落
#
# 角色对照（当前实验室默认）：
#   测试机 = 跑本仓库脚本的 PC（RYB-L16）：USB CAN / USB 串口，模拟载荷或地面设备
#   工控机 = 跑正式前后端的机器：接 PCIe CAN / 板载串口，浏览器测正式 UI
# 改接线或换机房：只改本文件（或临时环境变量），不要改 .py / .bat。
# =============================================================================

# -----------------------------------------------------------------------------
# 正式系统（工控机前端 / 登录）
# -----------------------------------------------------------------------------
# 浏览器打开的正式 UI 根地址（含端口，不要末尾斜杠）
HIL_FRONTEND_URL=http://192.168.100.52:12580
# 前端代理到后端的 API 前缀（与工控机 .env.production 一致，一般为 /prod-api）
HIL_API_PREFIX=/prod-api
# 登录账号 / 密码（正式系统默认管理员）
HIL_USERNAME=admin
HIL_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Playwright 浏览器
# -----------------------------------------------------------------------------
# 1=有头（可看操作）；0=无头。代码缺省按有头处理
HIL_HEADED=1
# 每步额外延迟（毫秒），便于人工观察
HIL_SLOW_MO_MS=200

# -----------------------------------------------------------------------------
# 遥测等待 / 周期
# -----------------------------------------------------------------------------
# 等待遥测字段出现的超时（秒）
HIL_TM_WAIT_S=15
# 串口/UDP 模拟器发遥测周期（秒）
HIL_TM_PERIOD=1.0

# -----------------------------------------------------------------------------
# 采集机 / 工控机标识
# -----------------------------------------------------------------------------
# 采集机标识（请求头 X-Collector-Host）。空=自动选 snapshot 里第一个 online（现网多为 gk3）
HIL_IPC_HOST=
# 工控机 IP（UDP 对端、测试机 IP 同网段探测用）。空则从 HIL_FRONTEND_URL 主机名推导
HIL_IPC_IP=192.168.100.52
# 1=目标 CAN/串口/UDP 已被占用时仍继续（尽量不关别人的口）；0=占用则失败
HIL_ALLOW_BUSY=0

# -----------------------------------------------------------------------------
# 测试机 CAN（gpcan vendor：DEMO=0, USB_V502=1, USB_ALYST_PRO=2, PCIE_ZLG=3）
# 当前：Alyst Pro 2 通道 USB-CAN，A=ch0 / B=ch1，与工控机 PCIe CAN 对线
# -----------------------------------------------------------------------------
HIL_CAN_VENDOR=2
HIL_CAN_DEV_INDEX=0
HIL_CAN_A_INDEX=0
HIL_CAN_B_INDEX=1

# -----------------------------------------------------------------------------
# 工控机 CAN（页面「新建CAN连接」里选的厂商/设备/通道）
# 当前：PCIe ZLG CANFD 2 通道，A=ch0 / B=ch1
# -----------------------------------------------------------------------------
HIL_IPC_CAN_VENDOR=3
HIL_IPC_CAN_DEV_INDEX=0
HIL_IPC_CAN_A_INDEX=0
HIL_IPC_CAN_B_INDEX=1

# 未指定 HIL_CAN_TARGET 时要覆盖的协议族（逗号分隔）。空=全部 biu,xl,yj216
HIL_CAN_DEFAULT_TARGETS=

# -----------------------------------------------------------------------------
# 串口（一对线：测试机 <-> 工控机；6 个串口协议轮流共用）
# 当前：测试机 FTDI USB-RS422 = COM9；工控机 Exar PCIe 串口卡 = COM11
# （个别文档旧称 COM8，以本文件为准）
# -----------------------------------------------------------------------------
HIL_SERIAL_PORT=COM9
HIL_IPC_SERIAL_PORT=COM11
# 未指定 HIL_SERIAL_TARGET 时的设备键列表。空=全部 SERIAL_KEYS
HIL_SERIAL_DEFAULT_TARGETS=
# 单设备覆盖示例（一般不必设）：
# HIL_SERIAL_XL_CAMERA=COM9
# HIL_IPC_SERIAL_XL_CAMERA=COM11

# -----------------------------------------------------------------------------
# UDP（关键机 xl_udp_dj：工控机:66 <-> 测试机:99）
# -----------------------------------------------------------------------------
HIL_UDP_IPC_PORT=66
HIL_UDP_TEST_PC_PORT=99
# 测试机本机 IP（工控机 UDP 远端地址）。空=自动探测与 HIL_IPC_IP 同网段的本机地址
HIL_TEST_PC_IP=
# 空=能绑定测试机端口则自动开；0=强制关；1=强制开
HIL_UDP_ENABLE=
# 未指定时覆盖的 UDP 键。空=全部 UDP_KEYS（当前仅 xl_udp_dj）
HIL_UDP_DEFAULT_KEYS=
# 高级覆盖（一般不必）：HIL_UDP_BIND=0.0.0.0:99  HIL_UDP_PEER=<工控机IP>:66

# -----------------------------------------------------------------------------
# MySQL（DUT 库结构对比 scenarios/test_db_schema.py）
# -----------------------------------------------------------------------------
HIL_DB_HOST=192.168.100.52
HIL_DB_PORT=3306
HIL_DB_USER=root
HIL_DB_PASSWORD=123456
HIL_DB_DATABASE=ruoyi-fastapi

# -----------------------------------------------------------------------------
# 运行期（一般由 run_hil.bat / 命令行推导，不必写死）
# -----------------------------------------------------------------------------
# HIL_RUN_DIR=          # 本次 artifacts 目录；空则自动 artifacts/<时间戳>
# HIL_CAN_TARGET=       # 单轮 CAN 协议：biu / xl / yj216
# HIL_SERIAL_TARGET=    # 单轮串口设备键
# HIL_GROUP=            # pytest 分组名（bat 设置）
#
# 报告：run_hil.bat 在全部套件结束后统一 fill；单测默认不在 session 末填表。
# 若直接 pytest 且想 session 末填表：HIL_FILL_ON_SESSION=1
# 强制跳过 session 填表（与 run_hil 一次填表语义一致）：HIL_SKIP_TEMPLATE_REPORT=1
